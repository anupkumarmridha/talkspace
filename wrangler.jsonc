{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talkspace",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Everything else is served straight from the edge asset store without
    // ever waking the Worker. Only these paths need Worker logic.
    "run_worker_first": ["/api/*", "/ws/*", "/r/*"]
  },

  "durable_objects": {
    "bindings": [
      { "name": "SIGNAL_ROOM", "class_name": "SignalRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },

  // SQLite-backed classes are the only kind available on the Workers Free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SignalRoom", "Lobby"] }
  ],

  "vars": {
    // Mesh topology: each peer uploads (N-1) copies of its stream, so this
    // stays low on purpose. Raise it only if you move to an SFU.
    "MAX_PEERS_PER_ROOM": "8",
    "ROOM_IDLE_TIMEOUT_MS": "120000"
  },

  "observability": {
    "enabled": true
  }
}
