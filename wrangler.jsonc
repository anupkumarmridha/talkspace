{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talkspace",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Everything else is served straight from the edge asset store without
    // ever waking the Worker. Only these paths need Worker logic.
    "run_worker_first": ["/api/*", "/ws/*", "/r/*"]
  },

  "durable_objects": {
    "bindings": [
      { "name": "SIGNAL_ROOM", "class_name": "SignalRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },

  // SQLite-backed classes are the only kind available on the Workers Free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SignalRoom", "Lobby"] }
  ],

  "vars": {
    // Mesh topology. Audio still goes to everyone, but video is subscribed to
    // by the receiver (see MAX_VIDEO_SUBSCRIPTIONS), so upload no longer
    // scales linearly with the room: a peer sends at most four camera streams
    // however many people are present. That is what makes 12 workable here
    // where a naive mesh runs out at about 6.
    "MAX_PEERS_PER_ROOM": "12",
    "ROOM_IDLE_TIMEOUT_MS": "120000"
  },

  "observability": {
    "enabled": true
  }
}
